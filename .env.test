# Application
NODE_ENV=test
PORT=3002

# Database — in-memory for tests
DB_PATH=:memory:

# HCM Mock — real server started in E2E tests
HCM_BASE_URL=http://localhost:3001
HCM_TIMEOUT_MS=2000
HCM_RETRY_ATTEMPTS=1
HCM_RETRY_DELAY_MS=50

# Sync
BALANCE_STALE_TTL_MINUTES=0
SYNC_CRON_EXPRESSION=*/15 * * * *
