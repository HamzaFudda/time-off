  "scripts": {
    "build": "nest build time-off",
    "build:hcm-mock": "nest build hcm-mock",
    "format": "prettier --write \"apps/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start time-off",
    "start:hcm-mock": "nest start hcm-mock",
    "start:dev": "nest start time-off --watch",
    "start:dev:hcm-mock": "nest start hcm-mock --watch",
    "start:debug": "nest start time-off --debug --watch",
    "start:prod": "node dist/apps/time-off/main",
    "lint": "eslint \"{apps,test}/**/*.ts\" --fix",
    "test": "jest --projects apps/time-off",
    "test:watch": "jest --projects apps/time-off --watch",
    "test:cov": "jest --projects apps/time-off --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
